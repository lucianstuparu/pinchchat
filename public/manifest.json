{
  "id": "/openclaw",
  "name": "OpenClaw",
  "short_name": "OpenClaw",
  "description": "Private messenger for your OpenClaw assistant. Share links, photos and files straight into the conversation.",
  "start_url": "/?ui=mobile",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "background_color": "#efeae2",
  "theme_color": "#00a884",
  "orientation": "portrait",
  "categories": [
    "productivity",
    "social",
    "utilities"
  ],
  "icons": [
    {
      "src": "/favicon-16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/logo-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/logo-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "text/*",
            "audio/*"
          ]
        }
      ]
    }
  }
}
