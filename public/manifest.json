{
  "id": "/openclaw",
  "name": "OpenClaw",
  "short_name": "OpenClaw",
  "description": "Private messenger for your OpenClaw assistant. Share links, photos and files straight into the conversation.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "background_color": "#f4ebdf",
  "theme_color": "#fdf7ef",
  "orientation": "portrait",
  "categories": [
    "productivity",
    "social",
    "utilities"
  ],
  "icons": [
    {
      "src": "/favicon-16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/logo-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/logo-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/logo-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "text/*",
            "audio/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Task",
      "short_name": "Task",
      "description": "Straight to the box, ready for a task",
      "url": "/?quick=task",
      "icons": [
        {
          "src": "/shortcuts/task.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Buy",
      "short_name": "Buy",
      "description": "Goes on the shopping list",
      "url": "/?quick=buy",
      "icons": [
        {
          "src": "/shortcuts/buy.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Voice message",
      "short_name": "Voice message",
      "description": "Starts recording right away",
      "url": "/?quick=voice",
      "icons": [
        {
          "src": "/shortcuts/voice.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Remind me",
      "short_name": "Remind me",
      "description": "Straight to the box, ready for a reminder",
      "url": "/?quick=remind",
      "icons": [
        {
          "src": "/shortcuts/remind.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
